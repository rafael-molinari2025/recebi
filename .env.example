# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Database
DATABASE_URL=postgresql://postgres:[password]@db.seu-projeto.supabase.co:5432/postgres

# Asaas (gateway de pagamento)
ASAAS_API_KEY=sua-api-key-asaas
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Em produção: https://www.asaas.com/api/v3

# Asaas Webhook — OBRIGATÓRIO para segurança do webhook
# Gere com: openssl rand -hex 32
# Configure o mesmo valor no painel Asaas > Configurações > Webhooks
ASAAS_WEBHOOK_TOKEN=gere-um-token-aleatorio-forte

# WhatsApp (Z-API)
ZAPI_INSTANCE_ID=sua-instance-id
ZAPI_TOKEN=seu-token
ZAPI_CLIENT_TOKEN=seu-client-token

# Cron Secret — OBRIGATÓRIO para proteger os endpoints de cron
# Gere com: openssl rand -hex 32
CRON_SECRET=gere-um-secret-aleatorio-forte

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
